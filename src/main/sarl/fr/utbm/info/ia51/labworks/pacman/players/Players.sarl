package fr.utbm.info.ia51.labworks.pacman.players

import fr.utbm.info.ia51.labworks.pacman.environment.^agent.DefaultMazeMotionSkill
import fr.utbm.info.ia51.labworks.pacman.environment.^agent.MazeMotion
import fr.utbm.info.ia51.labworks.pacman.environment.^agent.PacManIsDead
import fr.utbm.info.ia51.labworks.pacman.environment.^agent.Perception
import fr.utbm.info.ia51.labworks.pacman.environment.maze.Direction
import fr.utbm.info.ia51.labworks.pacman.environment.maze.PacmanBody
import io.sarl.api.core.Initialize
import io.sarl.api.core.Lifecycle
import java.util.List
import java.util.Random

import java.util.ArrayList
import fr.utbm.info.ia51.framework.math.Point2i
import fr.utbm.info.ia51.labworks.pacman.environment.maze.GhostBody
import fr.utbm.info.ia51.labworks.pacman.environment.maze.PacmanObject
import fr.utbm.info.ia51.labworks.pacman.environment.maze.WallObject

/** Ghost.
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
agent Ghost {
	
	uses MazeMotion, Lifecycle

	val random = new Random
	
	var previousDirection : Direction

	on PacManIsDead {
		killMe
	}

	on Perception {
		val pos = occurrence.position

		var pacman : PacmanBody = null
		for (o : occurrence.objects) {
			if (o instanceof PacmanBody) {
				pacman = o
			}
		}

		val free = new ArrayList<Direction>
		for (d : Direction::values) {
			if (isFree(pos, d, occurrence.objects)) {
				free.add(d)
			}
		}

		var chosen : Direction = null

		if (pacman !== null) {
			val dx = pacman.position.x - pos.x
			val dy = pacman.position.y - pos.y
			var toward = Direction::NORTH
			if (dx > 0) {
				toward = Direction::EAST
			} else if (dx < 0) {
				toward = Direction::WEST
			} else if (dy > 0) {
				toward = Direction::SOUTH
			}
			if (pacman.isSuperPacman()) {
				val away = toward.opposite
				if (free.contains(away)) {
					chosen = away
				} else {
					val others = new ArrayList<Direction>(free)
					others.remove(toward)
					if (!others.empty) {
						chosen = others.get(this.random.nextInt(others.size))
					}
				}
			} else if (free.contains(toward)) {
				chosen = toward
			}
		}

		if (chosen === null) {
			val candidates = new ArrayList<Direction>(free)
			if (this.previousDirection !== null && candidates.size > 1) {
				candidates.remove(this.previousDirection.opposite)
			}
			if (!candidates.empty) {
				if (candidates.size == 1) {
					chosen = candidates.get(0)
				} else {
					chosen = candidates.get(this.random.nextInt(candidates.size))
				}
			} else if (this.previousDirection !== null) {
				chosen = this.previousDirection
			} else {
				chosen = Direction::random
			}
		}

		this.previousDirection = chosen
		move(chosen)
	}

	def isFree(pos : Point2i, d : Direction, objects : List<PacmanObject>) : boolean {
		val tx = pos.x + d.toVector.x
		val ty = pos.y + d.toVector.y
		for (o : objects) {
			if (o.position.x == tx && o.position.y == ty) {
				if (o instanceof WallObject || o instanceof GhostBody) {
					return false
				}
			}
		}
		return true
	}

}
